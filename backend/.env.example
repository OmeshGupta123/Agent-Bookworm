# Razorpay API Credentials (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Database Configuration (Defaults to SQLite if PostgreSQL is unavailable)
DATABASE_URL=sqlite:///./agenticpay.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/AgentCart

# LLM Providers (Groq is the primary fast inference engine)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Commercial Policies & Guardrails
MAX_DISCOUNT_PERCENT=15.0
HUMAN_GATE_THRESHOLD=100000.0

# Security Token for Audit Cleanup Endpoint
AUDIT_CLEAR_TOKEN=your_secret_audit_clear_token
