# =================================================================
# AGENTICPAY / AGENT BOOKWORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env and frontend/.env respectively.
# =================================================================

# --- BACKEND (backend/.env) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

DATABASE_URL=sqlite:///./agenticpay.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/AgentCart

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

MAX_DISCOUNT_PERCENT=15.0
HUMAN_GATE_THRESHOLD=100000.0
AUDIT_CLEAR_TOKEN=your_secret_audit_clear_token

# --- FRONTEND (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
